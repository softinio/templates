//| mill-jvm-version: system
//| mvnDeps:
//|   - com.goyeau::mill-git::0.3.2

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import com.goyeau.mill.git.GitVersionedPublishModule

val munitV            = "1.3.4"
val catsVersion       = "2.13.0"
val catsEffectVersion = "3.7.0"
val fs2Version        = "3.13.0"
val munitCEVersion    = "2.2.0"
val scalaVersions     = Seq("3.3.8", "3.9.0")

object mylibrary extends Cross[MyLibraryModule](scalaVersions)

trait MyLibraryModule
    extends ScalaModule
    with CrossScalaModule
    with GitVersionedPublishModule:
  def artifactName = "mylibrary"

  override def artifactScalaVersion: T[String] = Task {
    val v = crossScalaVersion
    if v.startsWith("3.") then "3"
    else v.split('.').take(2).mkString(".")
  }

  // TODO: Adjust your library's mvnDeps here
  def mvnDeps = Seq(
    mvn"org.typelevel::cats-core:$catsVersion"
  )

  /** JDK used to compile and run this module.
    *
    * Empty means "whatever JDK Mill itself runs on", which in this devshell is
    * the 21 that the nixpkgs `mill` wrapper pins -- the same version these
    * artifacts target. CI sets this to exercise newer runtimes, because
    * `--release 21` guarantees the API surface exists but not that the code
    * behaves identically on a later JVM.
    */
  override def jvmVersion: T[String] = Task.Input {
    Task.env.getOrElse("MYLIBRARY_JVM", "")
  }

  def javacOptions = Seq("--release", "21")

  def scalacOptions =
    // 21 is the highest `-release` the 3.3 LTS compiler accepts, and the LTS is
    // the binding constraint while it stays in `scalaVersions`.
    val common = Seq("-explain", "-explain-types", "-release", "21")
    // `-Xkind-projector` landed after the 3.3 LTS line, which only has
    // `-Ykind-projector`. Gate on "not the LTS" so that bumping the newer
    // cross-version does not silently drop the flag.
    if crossScalaVersion.startsWith("3.3.") then common
    else common :+ "-Xkind-projector:underscores"

  def scalaDocOptions = Task {
    val version = docs.versionOverride().getOrElse(publishVersion())
    super.scalaDocOptions() ++ Seq(
      "-project",
      "MyLibrary",
      "-project-version",
      version,
      "-social-links:github::https://github.com/myorg/mylibrary",
      "-groups",
      "-snippet-compiler:compile",
      "-external-mappings:" +
        ".*scala.*::scaladoc3::https://scala-lang.org/api/3.x/," +
        ".*java.*::javadoc::https://docs.oracle.com/en/java/javase/21/docs/api/"
    )
  }

  /** Emits `<info.versionScheme>early-semver</info.versionScheme>` into the POM.
    * sbt reads it to decide whether a version bump is an eviction error or only
    * a warning; without it downstream users get noisier warnings against this
    * library than against its peers. cats, fs2, http4s and circe all set it.
    */
  override def versionScheme: T[Option[VersionScheme]] = Task {
    Some(VersionScheme.EarlySemVer)
  }

  def pomSettings = PomSettings(
    description = "A Scala 3 library",
    organization = "com.example",
    url = "https://github.com/myorg/mylibrary",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("myorg", "mylibrary"),
    developers = Seq(
      Developer(
        id = "myorg",
        name = "My Name",
        url = "https://example.com",
        email = "dev@example.com"
      )
    )
  )

  object test extends ScalaTests with TestModule.Munit:
    def mvnDeps = Seq(
      mvn"org.scalameta::munit::$munitV"
    )

object `mylibrary-cats-effect` extends Cross[MyLibraryCatsEffectModule](scalaVersions)

trait MyLibraryCatsEffectModule
    extends ScalaModule
    with CrossScalaModule
    with GitVersionedPublishModule:
  def artifactName = "mylibrary-cats-effect"

  def moduleDeps = Seq(mylibrary(crossScalaVersion))

  override def artifactScalaVersion: T[String] = Task {
    val v = crossScalaVersion
    if v.startsWith("3.") then "3"
    else v.split('.').take(2).mkString(".")
  }

  def mvnDeps = Seq(
    mvn"org.typelevel::cats-effect:$catsEffectVersion",
    mvn"co.fs2::fs2-core:$fs2Version"
  )

  /** JDK used to compile and run this module.
    *
    * Empty means "whatever JDK Mill itself runs on", which in this devshell is
    * the 21 that the nixpkgs `mill` wrapper pins -- the same version these
    * artifacts target. CI sets this to exercise newer runtimes, because
    * `--release 21` guarantees the API surface exists but not that the code
    * behaves identically on a later JVM.
    */
  override def jvmVersion: T[String] = Task.Input {
    Task.env.getOrElse("MYLIBRARY_JVM", "")
  }

  def javacOptions = Seq("--release", "21")

  def scalacOptions =
    // 21 is the highest `-release` the 3.3 LTS compiler accepts, and the LTS is
    // the binding constraint while it stays in `scalaVersions`.
    val common = Seq("-explain", "-explain-types", "-release", "21")
    // `-Xkind-projector` landed after the 3.3 LTS line, which only has
    // `-Ykind-projector`. Gate on "not the LTS" so that bumping the newer
    // cross-version does not silently drop the flag.
    if crossScalaVersion.startsWith("3.3.") then common
    else common :+ "-Xkind-projector:underscores"

  def scalaDocOptions = Task {
    val version = docs.versionOverride().getOrElse(publishVersion())
    super.scalaDocOptions() ++ Seq(
      "-project",
      "MyLibrary Cats Effect",
      "-project-version",
      version,
      "-social-links:github::https://github.com/myorg/mylibrary",
      "-groups",
      "-external-mappings:" +
        ".*scala.*::scaladoc3::https://scala-lang.org/api/3.x/," +
        ".*java.*::javadoc::https://docs.oracle.com/en/java/javase/21/docs/api/"
    )
  }

  /** Emits `<info.versionScheme>early-semver</info.versionScheme>` into the POM.
    * sbt reads it to decide whether a version bump is an eviction error or only
    * a warning; without it downstream users get noisier warnings against this
    * library than against its peers. cats, fs2, http4s and circe all set it.
    */
  override def versionScheme: T[Option[VersionScheme]] = Task {
    Some(VersionScheme.EarlySemVer)
  }

  def pomSettings = PomSettings(
    description = "A Scala 3 library",
    organization = "com.example",
    url = "https://github.com/myorg/mylibrary",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("myorg", "mylibrary"),
    developers = Seq(
      Developer(
        id = "myorg",
        name = "My Name",
        url = "https://example.com",
        email = "dev@example.com"
      )
    )
  )

  object test extends ScalaTests with TestModule.Munit:
    def mvnDeps = Seq(
      mvn"org.scalameta::munit::$munitV",
      mvn"org.typelevel::munit-cats-effect::$munitCEVersion"
    )

/** Documentation site (Laika + Helium theme, rendered from `docs/`).
  *
  * Both commands shell out to scala-cli (provided by the devshell) to run the
  * scripts in `scripts/`.
  *
  *   - `mill docs.build` — build the site into `site/target/docs/site`
  *   - `mill docs.preview` — build, then serve that output at
  *     http://localhost:4242
  *
  * Preview serves what `build` produced rather than re-rendering, so the two
  * cannot drift. Note it holds Mill's workspace lock for as long as it serves,
  * so nothing else can build meanwhile.
  */
object docs extends Module:

  /** `MYLIBRARY_DOC_VERSION`, which the docs workflow sets from the release tag.
    * An input, like `jvmVersion`, so it is re-read on every run: a plain task
    * that reads `Task.env` is cached, and silently keeps the version from the
    * last build when only the variable changes. The Scaladoc options read it
    * too.
    */
  def versionOverride: T[Option[String]] = Task.Input {
    Task.env.get("MYLIBRARY_DOC_VERSION")
  }

  /** The version the pages show in place of `@VERSION@`: the override if set,
    * otherwise the git-derived version.
    */
  def siteVersion: T[String] = Task {
    versionOverride().getOrElse(mylibrary("3.3.8").publishVersion())
  }

  def build() = Task.Command {
    renderSite(siteVersion())
  }

  def preview() = Task.Command {
    val projectRoot = mill.api.BuildCtx.workspaceRoot
    renderSite(siteVersion())
    mill.api.BuildCtx.withFilesystemCheckerDisabled {
      os.proc("scala-cli", "run", (projectRoot / "scripts" / "LaikaPreview.scala").toString)
        .call(cwd = projectRoot, stdout = os.Inherit, stderr = os.Inherit)
    }
    ()
  }

  private def renderSite(version: String): PathRef =
    val projectRoot = mill.api.BuildCtx.workspaceRoot
    val siteDir     = projectRoot / "site" / "target" / "docs" / "site"

    println(s"Building documentation site for $version...")
    mill.api.BuildCtx.withFilesystemCheckerDisabled {
      os.proc("scala-cli", "run", (projectRoot / "scripts" / "LaikaBuild.scala").toString)
        .call(
          cwd = projectRoot,
          env = Map("MYLIBRARY_DOC_VERSION" -> version),
          stdout = os.Inherit,
          stderr = os.Inherit
        )
    }
    println(s"Site built at: $siteDir")
    PathRef(siteDir)
